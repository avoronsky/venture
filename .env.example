# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable / anon key. It is safe in the browser; row level security protects the data.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# URL path the app is served from. "/" locally or on a custom domain; "/venture/" on GitHub Pages.
VITE_BASE_PATH=/
